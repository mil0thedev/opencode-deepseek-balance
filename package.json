{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-deepseek-balance",
  "version": "0.3.0",
  "description": "DeepSeek balance and peak/off-peak pricing in your OpenCode TUI sidebar.",
  "type": "module",
  "license": "MIT",
  "author": "MiloTheDev (https://github.com/mil0thedev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mil0thedev/opencode-deepseek-balance.git"
  },
  "homepage": "https://github.com/mil0thedev/opencode-deepseek-balance#readme",
  "bugs": {
    "url": "https://github.com/mil0thedev/opencode-deepseek-balance/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui-plugin",
    "deepseek",
    "balance",
    "tui"
  ],
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "src",
    "assets",
    "README.md",
    "README.es.md",
    "FUTURES.md",
    "FUTURES.es.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "opencode": "^1.19.0"
  },
  "scripts": {
    "build": "babel src --out-dir dist --extensions \".ts,.tsx\" --source-maps",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/balance.test.ts test/peak.test.ts test/retry.test.ts test/version.test.ts",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.19.0",
    "@opentui/core": ">=0.4.5",
    "@opentui/keymap": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/keymap": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode-ai/plugin": "^1.19.4",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/node": "^24.0.0",
    "babel-preset-solid": "1.9.12",
    "solid-js": "1.9.12",
    "typescript": "^5.8.2"
  }
}
